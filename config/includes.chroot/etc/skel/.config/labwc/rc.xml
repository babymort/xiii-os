<?xml version="1.0"?>
<labwc_config>
  <core><gap>6</gap></core>
  <snapping><range>10</range><cornerRange>60</cornerRange><overlay enabled="yes"><delay inner="300" outer="300" /></overlay><topMaximize>yes</topMaximize></snapping>
  <desktops number="2"><popupTime>600</popupTime></desktops>
  <windowSwitcher show="yes" preview="yes" outlines="yes" />
  <theme>
    <name>XIII</name>
    <icon>XIII</icon>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow"><name>IBM Plex Sans</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>IBM Plex Sans</name><size>10</size></font>
  </theme>
  <magnifier><width>-1</width><height>-1</height><initScale>2.0</initScale><increment>0.5</increment><useFilter>true</useFilter></magnifier>
  <regions>
    <region name="gauche" x="0%" y="0%" width="50%" height="100%" />
    <region name="droite" x="50%" y="0%" width="50%" height="100%" />
    <region name="haut-gauche" x="0%" y="0%" width="50%" height="50%" />
    <region name="haut-droite" x="50%" y="0%" width="50%" height="50%" />
    <region name="bas-gauche" x="0%" y="50%" width="50%" height="50%" />
    <region name="bas-droite" x="50%" y="50%" width="50%" height="50%" />
    <region name="tiers-gauche" x="0%" y="0%" width="33%" height="100%" />
    <region name="tiers-centre" x="33%" y="0%" width="34%" height="100%" />
    <region name="tiers-droite" x="67%" y="0%" width="33%" height="100%" />
    <region name="deux-tiers-gauche" x="0%" y="0%" width="67%" height="100%" />
    <region name="deux-tiers-droite" x="33%" y="0%" width="67%" height="100%" />
    <region name="centre" x="15%" y="10%" width="70%" height="80%" />
  </regions>
  <keyboard>
    <default />
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="xiii-ctl demarrer" /></keybind>
    <keybind key="W-s"><action name="Execute" command="xiii-ctl demarrer-recherche" /></keybind>
    <keybind key="W-space"><action name="Execute" command="xiii-ctl demarrer-recherche" /></keybind>
    <keybind key="W-a"><action name="Execute" command="xiii-ctl centre" /></keybind>
    <keybind key="W-n"><action name="Execute" command="xiii-ctl volet" /></keybind>
    <keybind key="W-i"><action name="Execute" command="xiii-parametres" /></keybind>
    <keybind key="W-S-s"><action name="Execute" command="xiii-outil-capture" /></keybind>
    <keybind key="Print"><action name="Execute" command="xiii-outil-capture" /></keybind>
    <keybind key="W-Print"><action name="Execute" command="xiii-capture menu" /></keybind>
    <keybind key="W-S-r"><action name="Execute" command="xiii-capture video ecran" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="W-Down"><action name="Iconify" /></keybind>
    <keybind key="W-A-S-1"><action name="SendToDesktop" to="1" follow="no" /></keybind>
    <keybind key="W-A-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-A-S-2"><action name="SendToDesktop" to="2" follow="no" /></keybind>
    <keybind key="W-A-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-A-S-3"><action name="SendToDesktop" to="3" follow="no" /></keybind>
    <keybind key="W-A-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-A-S-4"><action name="SendToDesktop" to="4" follow="no" /></keybind>
    <keybind key="W-A-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-A-S-5"><action name="SendToDesktop" to="5" follow="no" /></keybind>
    <keybind key="W-A-5"><action name="GoToDesktop" to="5" /></keybind>
    <keybind key="W-A-S-6"><action name="SendToDesktop" to="6" follow="no" /></keybind>
    <keybind key="W-A-6"><action name="GoToDesktop" to="6" /></keybind>
    <keybind key="C-W-Left"><action name="GoToDesktop" to="left" wrap="yes" /></keybind>
    <keybind key="C-W-Right"><action name="GoToDesktop" to="right" wrap="yes" /></keybind>
    <keybind key="W-A-F1"><action name="SnapToRegion" region="gauche" /></keybind>
    <keybind key="W-A-F2"><action name="SnapToRegion" region="droite" /></keybind>
    <keybind key="W-A-F3"><action name="SnapToRegion" region="haut-gauche" /></keybind>
    <keybind key="W-A-F4"><action name="SnapToRegion" region="haut-droite" /></keybind>
    <keybind key="W-A-F5"><action name="SnapToRegion" region="bas-gauche" /></keybind>
    <keybind key="W-A-F6"><action name="SnapToRegion" region="bas-droite" /></keybind>
    <keybind key="W-A-F7"><action name="SnapToRegion" region="tiers-gauche" /></keybind>
    <keybind key="W-A-F8"><action name="SnapToRegion" region="tiers-centre" /></keybind>
    <keybind key="W-A-F9"><action name="SnapToRegion" region="tiers-droite" /></keybind>
    <keybind key="W-A-F10"><action name="SnapToRegion" region="deux-tiers-gauche" /></keybind>
    <keybind key="W-A-F11"><action name="SnapToRegion" region="deux-tiers-droite" /></keybind>
    <keybind key="W-A-F12"><action name="SnapToRegion" region="centre" /></keybind>
    <keybind key="W-Tab"><action name="Execute" command="xiii-ctl vue" /></keybind>
    <keybind key="W-z"><action name="Execute" command="xiii-ctl dispositions" /></keybind>
    <keybind key="W-v"><action name="Execute" command="xiii-ctl presse" /></keybind>
    <keybind key="W-period"><action name="Execute" command="xiii-ctl emoji" /></keybind>
    <keybind key="W-semicolon"><action name="Execute" command="xiii-ctl emoji" /></keybind>
    <keybind key="W-d"><action name="Execute" command="xiii-ctl bureau" /></keybind>
    <keybind key="W-w"><action name="Execute" command="xiii-ctl widgets" /></keybind>
    <keybind key="W-c"><action name="Execute" command="claude-desktop" /></keybind>
    <keybind key="W-S-c"><action name="Execute" command="xiii-claude-code" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot --app-id=fr.xiii.terminal" /></keybind>
    <keybind key="W-j"><action name="Execute" command="xiii-ia" /></keybind>
    <keybind key="W-A-s"><action name="Execute" command="xiii-acces --lecteur" /></keybind>
    <keybind key="W-equal"><action name="ZoomIn" /></keybind>
    <keybind key="W-plus"><action name="ZoomIn" /></keybind>
    <keybind key="W-minus"><action name="ZoomOut" /></keybind>
    <keybind key="W-A-m"><action name="ToggleMagnify" /></keybind>
    <keybind key="W-A-c"><action name="Execute" command="xiii-acces --contraste" /></keybind>
    <keybind key="W-A-k"><action name="Execute" command="xiii-acces --clavier" /></keybind>
    <keybind key="C-W-l"><action name="Execute" command="xiii-acces --soustitres" /></keybind>
    <keybind key="W-A-h"><action name="Execute" command="xiii-acces --dicter" /></keybind>
    <keybind key="W-A-t"><action name="Execute" command="xiii-acces --traduire" /></keybind>
    <keybind key="A-Tab"><action name="Execute" command="xiii-ctl alttab" /></keybind>
    <keybind key="A-S-Tab"><action name="Execute" command="xiii-ctl alttab-prec" /></keybind>
    <keybind key="W-h"><action name="Execute" command="xiii-voix" /></keybind>
    <keybind key="C-A-t"><action name="Execute" command="foot --app-id=fr.xiii.terminal" /></keybind>
    <keybind key="C-S-Escape"><action name="Execute" command="xiii-taches" /></keybind>
    <keybind key="W-e"><action name="Execute" command="xiii-fichiers" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set +5%" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-" /></keybind>
    <keybind key="W-l"><action name="Execute" command="swaylock -f" /></keybind>
    <keybind key="XF86TouchpadToggle"><action name="Execute" command="labwc --reconfigure" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
  </keyboard>
  <mouse><default /></mouse>
  <libinput><device category="touchpad"><tap>yes</tap><naturalScroll>yes</naturalScroll></device></libinput>
</labwc_config>
