<?xml version="1.0"?>
<labwc_config>
  <core><gap>6</gap></core>
  <snapping><range>10</range><topMaximize>yes</topMaximize></snapping>
  <desktops number="2"><popupTime>600</popupTime></desktops>
  <windowSwitcher show="yes" preview="yes" outlines="yes" />
  <theme>
    <name>XIII</name>
    <icon>XIII</icon>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow"><name>IBM Plex Sans</name><size>10</size><weight>bold</weight></font>
    <font place="MenuItem"><name>IBM Plex Sans</name><size>10</size></font>
  </theme>
  <keyboard>
    <default />
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="xiii-ctl demarrer" /></keybind>
    <keybind key="W-s"><action name="Execute" command="xiii-ctl demarrer-recherche" /></keybind>
    <keybind key="W-a"><action name="Execute" command="xiii-ctl centre" /></keybind>
    <keybind key="W-n"><action name="Execute" command="xiii-ctl volet" /></keybind>
    <keybind key="W-i"><action name="Execute" command="xiii-parametres" /></keybind>
    <keybind key="W-S-s"><action name="Execute" command="xiii-capture zone" /></keybind>
    <keybind key="Print"><action name="Execute" command="xiii-capture ecran" /></keybind>
    <keybind key="W-v"><action name="Execute" command="xiii-presse-papiers" /></keybind>
    <keybind key="W-Left"><action name="SnapToEdge" direction="left" /></keybind>
    <keybind key="W-Right"><action name="SnapToEdge" direction="right" /></keybind>
    <keybind key="W-Down"><action name="Iconify" /></keybind>
    <keybind key="C-W-Left"><action name="GoToDesktop" to="left" wrap="yes" /></keybind>
    <keybind key="C-W-Right"><action name="GoToDesktop" to="right" wrap="yes" /></keybind>
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="W-e"><action name="Execute" command="thunar" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle" /></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="brightnessctl set +5%" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="brightnessctl set 5%-" /></keybind>
    <keybind key="W-l"><action name="Execute" command="swaylock -f" /></keybind>
    <keybind key="XF86TouchpadToggle"><action name="Execute" command="labwc --reconfigure" /></keybind>
    <keybind key="A-F4"><action name="Close" /></keybind>
    <keybind key="W-Up"><action name="ToggleMaximize" /></keybind>
  </keyboard>
  <mouse><default /></mouse>
  <libinput><device category="touchpad"><tap>yes</tap><naturalScroll>yes</naturalScroll></device></libinput>
</labwc_config>
