<?xml version="1.0" encoding="UTF-8"?>
<actions>
<action>
	<icon>view-reveal-symbolic</icon>
	<name>Aperçu rapide</name>
	<submenu></submenu>
	<unique-id>xiii-apercu-1</unique-id>
	<command>xiii-apercu %f</command>
	<description>Voir le fichier sans l'ouvrir (Espace)</description>
	<range>1-1</range>
	<patterns>*</patterns>
	<audio-files/>
	<image-files/>
	<other-files/>
	<text-files/>
	<video-files/>
</action>
<action>
	<icon>xiii-somme</icon>
	<name>Vérifier (somme de contrôle)</name>
	<unique-id>xiii-somme-1</unique-id>
	<command>xiii-somme %f</command>
	<description>Calculer les empreintes et créer un rapport MHL</description>
	<patterns>*</patterns>
	<directories/>
	<other-files/>
</action>
<action>
	<icon>xiii-somme</icon>
	<name>Comparer la copie avec la source…</name>
	<unique-id>xiii-somme-2</unique-id>
	<command>xiii-somme %F</command>
	<description>Sélectionnez la source puis la copie (Ctrl+clic)</description>
	<patterns>*</patterns>
	<directories/>
</action>
<action>
	<icon>xiii-windows</icon>
	<name>Installer / lancer avec Applications Windows</name>
	<unique-id>xiii-windows-1</unique-id>
	<command>xiii-windows %f</command>
	<description>Logiciel Windows (.exe, .msi)</description>
	<patterns>*.exe;*.EXE;*.msi;*.MSI</patterns>
	<other-files/>
</action>
<action>
	<icon>claude-desktop</icon>
	<name>Ouvrir Claude Code ici</name>
	<unique-id>xiii-claude-1</unique-id>
	<command>xiii-claude-code %f</command>
	<description>Claude Code dans ce dossier</description>
	<patterns>*</patterns>
	<directories/>
</action>
<action>
	<icon>xiii-suite-dossier</icon>
	<name>Envoyer à DOSSIER XIII</name>
	<unique-id>xiii-suite-dossier-1</unique-id>
	<command>xiii-suite --dossier %F</command>
	<description>Ajouter au dossier de production ou technique en cours</description>
	<patterns>*</patterns>
	<other-files/>
	<text-files/>
	<image-files/>
</action>
<action>
	<icon>xiii-suite-encodo</icon>
	<name>Convertir avec ENCODO XIII</name>
	<unique-id>xiii-suite-encodo-1</unique-id>
	<command>xiii-suite --encodo %F</command>
	<description>Vidéo, son, image, PDF : changer de format, de codec ou de taille</description>
	<patterns>*</patterns>
	<audio-files/>
	<image-files/>
	<video-files/>
	<other-files/>
</action>
<action>
	<icon>xiii-suite</icon>
	<name>Ouvrir dans la Suite XIII</name>
	<unique-id>xiii-suite-ouvrir-1</unique-id>
	<command>xiii-suite --ouvrir %f</command>
	<description>Ouvrir ce fichier dans le bon outil de la suite</description>
	<patterns>*.json</patterns>
	<other-files/>
	<text-files/>
</action>
</actions>
