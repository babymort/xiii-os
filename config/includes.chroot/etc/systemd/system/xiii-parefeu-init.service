[Unit]
Description=OS XIII — première activation du pare-feu (exceptions pour le réseau local)
ConditionPathExists=!/etc/xiii/parefeu.json
# ufw (tout refuser en entrée) est déjà actif dès le démarrage : les exceptions du réseau local s'ajoutent
# une fois le bureau affiché, en arrière-plan, au lieu de retarder le démarrage de 12 s
After=ufw.service local-fs.target graphical.target
Wants=ufw.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/xiii-parefeu init
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=graphical.target
