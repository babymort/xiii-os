# OS XIII — déverrouillage de l'écran : mot de passe, visage ou empreinte.
# Mot de passe tapé : vérifié tout de suite. Entrée sans rien taper : visage puis empreinte (s'ils sont enregistrés),
# chacun limité à quelques secondes : l'écran ne reste jamais bloqué, le mot de passe marche toujours ensuite.
auth    sufficient   pam_unix.so try_first_pass nullok nodelay
auth    sufficient   pam_exec.so quiet /usr/local/lib/xiii/verrou-biometrie
auth    required     pam_deny.so
account include      common-account
