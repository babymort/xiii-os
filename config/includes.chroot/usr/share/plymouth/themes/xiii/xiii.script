# OS XIII — logo cuivre qui respire + anneau de chargement qui tourne
Window.SetBackgroundTopColor(0.10, 0.10, 0.10);
Window.SetBackgroundBottomColor(0.06, 0.06, 0.06);
cx = Window.GetWidth() / 2; cy = Window.GetHeight() / 2;
halo = Sprite(Image("halo.png"));
halo.SetX(cx - halo.GetImage().GetWidth() / 2); halo.SetY(cy - halo.GetImage().GetHeight() / 2 - 40); halo.SetZ(1);
logo = Sprite(Image("logo.png"));
logo.SetX(cx - logo.GetImage().GetWidth() / 2); logo.SetY(cy - logo.GetImage().GetHeight() / 2 - 40); logo.SetZ(2);
anneau_img = Image("anneau.png");
anneau = Sprite(anneau_img); anneau.SetZ(3);
anneau.SetX(cx - anneau_img.GetWidth() / 2); anneau.SetY(cy + 110);
t = 0;
fun refresh_callback () {
  t++;
  a = 0.55 + 0.45 * Math.Sin(t / 18);
  halo.SetOpacity(a * 0.8);
  logo.SetOpacity(0.75 + 0.25 * a);
  anneau.SetImage(anneau_img.Rotate(t * 0.105));
}
Plymouth.SetRefreshFunction(refresh_callback);
msg = Sprite(); msg.SetZ(3);
fun message_callback (text) {
  img = Image.Text(text, 0.6, 0.57, 0.54);
  msg.SetImage(img); msg.SetX(cx - img.GetWidth() / 2); msg.SetY(cy + 175);
}
Plymouth.SetMessageFunction(message_callback);
