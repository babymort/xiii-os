<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <action id="fr.xiii.theme.systeme">
    <description>Appliquer le thème à l'écran de connexion et au démarrage</description>
    <message>Appliquer le thème XIII à l'écran de connexion et à l'animation de démarrage</message>
    <defaults><allow_any>auth_admin</allow_any><allow_inactive>auth_admin</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/xiii-theme-systeme</annotate>
  </action>
</policyconfig>
