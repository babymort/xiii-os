#!/bin/sh
# OS XIII — installe Steam (licence de Valve acceptée d'avance) et ses bibliothèques 32 bits. Lancé par pkexec depuis la Console ou le Centre de logiciels.
set -e
[ "$(dpkg --print-architecture)" = amd64 ] || { echo "Steam n'existe que pour les PC (amd64)"; exit 2; }
echo "steam steam/question select I AGREE" | debconf-set-selections
echo "steam steam/license note ''" | debconf-set-selections
echo "steam-installer steam/question select I AGREE" | debconf-set-selections
dpkg --add-architecture i386
apt-get update -qq
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends steam-installer steam-devices \
  mesa-vulkan-drivers:i386 libgl1-mesa-dri:i386 libglx-mesa0:i386 libvulkan1:i386
