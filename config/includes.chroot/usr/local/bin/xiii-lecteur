#!/bin/sh
# OS XIII — XIII Lecteur : lecteur vidéo pro (mpv) — image par image, timecode, boucle A/B, scopes, sous-titres
exec mpv --config-dir=/usr/share/xiii/lecteur --input-conf=/usr/share/xiii/lecteur/input.conf --script=/usr/share/xiii/lecteur/xiii.lua --force-window=yes --player-operation-mode=pseudo-gui "$@"
