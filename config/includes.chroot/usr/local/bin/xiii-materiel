#!/bin/bash
# OS XIII — bilan matériel. Usage : xiii-materiel
A='\e[38;2;240;179;120m'; V='\e[32m'; R='\e[31m'; G='\e[90m'; N='\e[0m'
ok(){ printf "  ${V}●${N} %-12s %s\n" "$1" "$2"; }
ko(){ printf "  ${R}●${N} %-12s %s\n" "$1" "$2"; }
printf "\n${A}  OS XIII — bilan matériel${N}\n\n"
cpu=$(grep -m1 'model name' /proc/cpuinfo | cut -d: -f2 | xargs)
ram=$(free -h | awk '/Mem:/{print $2}')
ok "Processeur" "$cpu"
ok "Mémoire" "$ram"
gpu=$(lspci | grep -iE 'vga|3d|display' | cut -d: -f3- | xargs)
[ -n "$gpu" ] && ok "Carte graph." "$gpu" || ko "Carte graph." "non détectée"
if lspci | grep -iq nvidia; then printf "  ${G}  └ NVIDIA : pilote conseillé → $(nvidia-detect 2>/dev/null | grep -oE 'nvidia-[a-z0-9-]+' | head -1)${N}\n"; fi
wifi=$(iw dev 2>/dev/null | awk '/Interface/{print $2}' | head -1)
if [ -n "$wifi" ]; then
  ssid=$(iw dev "$wifi" link 2>/dev/null | awk -F': ' '/SSID/{print $2}')
  ok "Wifi" "$wifi ${ssid:+— connecté à $ssid}"
  [ -z "$ssid" ] && printf "  ${G}  └ se connecter : nmtui${N}\n"
else ko "Wifi" "aucune carte (ou firmware manquant)"; fi
eth=$(ip -o link | awk -F': ' '$2 ~ /^(en|eth)/{print $2}' | head -1)
[ -n "$eth" ] && ok "Ethernet" "$eth $(cat /sys/class/net/$eth/operstate 2>/dev/null)" || ko "Ethernet" "aucun port"
if ping -c1 -W2 1.1.1.1 >/dev/null 2>&1; then ok "Internet" "connecté"; else ko "Internet" "pas de connexion"; fi
if bluetoothctl list 2>/dev/null | grep -q Controller; then ok "Bluetooth" "$(bluetoothctl list | head -1 | cut -d' ' -f2)"; else ko "Bluetooth" "aucun adaptateur"; fi
cards=$(aplay -l 2>/dev/null | grep -c '^carte\|^card')
[ "$cards" -gt 0 ] && ok "Son" "$cards carte(s) — $(aplay -l 2>/dev/null | grep -m1 -oP '\[\K[^]]+')" || ko "Son" "aucune carte"
cams=$(ls /dev/video* 2>/dev/null | wc -l)
[ "$cams" -gt 0 ] && ok "Webcam" "$cams périphérique(s)" || printf "  ${G}●${N} %-12s %s\n" "Webcam" "aucune"
if ls /sys/class/power_supply/BAT* >/dev/null 2>&1; then ok "Batterie" "$(cat /sys/class/power_supply/BAT*/capacity | head -1)%"; fi
miss=$(dmesg 2>/dev/null | grep -ciE 'firmware.*(failed|missing)')
[ "${miss:-0}" -gt 0 ] && printf "\n  ${R}⚠ $miss firmware(s) manquant(s)${N} — détail : sudo dmesg | grep -i firmware\n"
echo
