#!/bin/sh
# xiii-maj: relancer (mise à jour d'OS XIII : ce script est relancé quand il change)
# Pack conseillé XIII : 20 logiciels présents dans le menu (nom, icône) et téléchargés au premier lancement.
set -e
python3 -c 'import sys; sys.path.insert(0, "/usr/lib/xiii"); from xiii.pack import icones; icones()'
gtk-update-icon-cache -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
