#!/bin/sh
# Phase 07 — Steam (licence acceptée d'avance), Vulkan / OpenGL 32 bits, GameMode, MangoHud
set -e
echo "steam steam/question select I AGREE" | debconf-set-selections
echo "steam steam/license note ''" | debconf-set-selections
echo "steam-installer steam/question select I AGREE" | debconf-set-selections
apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends steam-installer steam-devices \
  mesa-vulkan-drivers:i386 libgl1-mesa-dri:i386 libglx-mesa0:i386 libvulkan1:i386 gamemode mangohud vulkan-tools
apt-get clean

# Mode Gaming : RetroArch et quelques cœurs d'émulation libres (chacun facultatif)
for p in retroarch libretro-nestopia libretro-snes9x libretro-mgba libretro-gambatte libretro-genesisplusgx libretro-desmume libretro-beetle-pce-fast; do
  DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "$p" || echo "absent : $p"
done
