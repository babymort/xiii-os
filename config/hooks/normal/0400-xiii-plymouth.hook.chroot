#!/bin/sh
set -e
# Animations ASCII du logo XIII (10 variantes, choix dans Paramètres › Animation de démarrage) ; « Machine à écrire » par défaut
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends python3-pil fonts-dejavu-core
python3 /usr/lib/xiii/xiii/ascii_boot.py /usr/share/plymouth/themes
plymouth-set-default-theme xiii-ascii-machine || plymouth-set-default-theme xiii
update-initramfs -u
