#!/bin/sh
# Phase 14 — ménage : paquets tirés par les « recommandés » de Debian mais inutiles sur un PC de bureau.
# Chaque paquet n'est retiré que si rien d'installé n'en dépend vraiment (simulation d'abord) : aucune fonction perdue.
set -e
CANDIDATS="fonts-noto-extra fonts-noto-ui-extra fonts-noto-cjk-extra firmware-netronome firmware-marvell-prestera firmware-qcom-soc firmware-nvidia-tesla-535-gsp
 firmware-nvidia-tesla-470-gsp firmware-ast firmware-qlogic firmware-bnx2x firmware-cavium firmware-myricom firmware-netxen firmware-siano firmware-ivtv
 pocketsphinx-en-us build-essential dpkg-dev g++ gcc g++-14 gcc-14 libstdc++-14-dev cpp cpp-14 libc6-dev linux-libc-dev
 manpages-dev qemu-system-data xserver-xorg-video-all mlocate texlive-base yelp gnome-user-docs"
for p in $CANDIDATS; do
  dpkg -s "$p" >/dev/null 2>&1 || continue
  n=$(apt-get -s purge "$p" 2>/dev/null | grep -c '^Purg ' || true)
  if [ "$n" = 1 ]; then
    DEBIAN_FRONTEND=noninteractive apt-get purge -y -qq "$p" >/dev/null && echo "ménage : $p retiré"
  else
    echo "ménage : $p gardé ($n paquets en dépendent)"
  fi
done
DEBIAN_FRONTEND=noninteractive apt-get autoremove -y --purge -qq >/dev/null || true
apt-get clean
rm -rf /usr/share/doc/*/changelog* /var/cache/apt/*.bin /var/lib/apt/lists/*_Packages 2>/dev/null || true
# documentation hors français / anglais (pages de manuel traduites, aides) : plusieurs dizaines de Mo
find /usr/share/man -mindepth 1 -maxdepth 1 -type d ! -name 'man*' ! -name fr ! -name 'fr.*' -exec rm -rf {} + 2>/dev/null || true
