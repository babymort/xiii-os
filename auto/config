#!/bin/sh
# OS XIII — configuration live-build (phase 01 : socle bootable)
set -e
lb config noauto \
  --distribution trixie \
  --architectures amd64 \
  --archive-areas "main contrib non-free non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --binary-images iso-hybrid \
  --debian-installer none \
  --iso-application "OS XIII" \
  --iso-publisher "Matthieu Lamotte" \
  --iso-volume "OS_XIII" \
  --bootappend-live "boot=live components quiet splash locales=fr_FR.UTF-8 keyboard-layouts=fr timezone=Europe/Paris username=xiii hostname=xiii-os" \
  --memtest none \
  "${@}"
